PROJECT_NAME           = "SerialRTT"
PROJECT_BRIEF          = "Arduino Stream-compatible SEGGER RTT serial implementation"
PROJECT_NUMBER         = "1.0.0"
OUTPUT_DIRECTORY       = docs/_build
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
EXTENSION_MAPPING      = ino=C++
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES
INPUT                  = README.md src/SerialRTT.h
RECURSIVE              = NO
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.md *.ino
EXCLUDE                = src/SEGGER_RTT
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
INLINE_SOURCES         = NO
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
USE_MDFILE_AS_MAINPAGE = README.md
